{
  "name": "ontario-teacher-assessment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx src/benchmarks/runBrowserBenchmark.ts",
    "benchmark:node": "tsx src/benchmarks/nodeBenchmark.ts",
    "benchmark:browser": "tsx src/benchmarks/runBrowserBenchmark.ts",
    "test:workflow": "tsx src/benchmarks/visualTestWorkflow.ts",
    "test:browser:ux": "tsx src/benchmarks/browserUxE2ETest.ts",
    "electron:dev": "electron .",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "test:mac:packages": "tsx src/benchmarks/macPackagesSmoke.ts",
    "ios:prepare": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test:ipad:browser": "tsx scripts/nativePilotSmoke.ts",
    "test:ipad:assets": "tsx scripts/auditNativePilot.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "clsx": "^2.1.1",
    "dexie": "^4.0.7",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "ca.on.teacher.assessment",
    "productName": "Ontario Teacher Assessment",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "OntarioTeacherAssessment-${version}-${arch}-nsis.exe"
    },
    "portable": {
      "artifactName": "OntarioTeacherAssessment-${version}-${arch}-Portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "OntarioTeacherAssessment-${version}-mac-${arch}.${ext}"
    }
  }
}
